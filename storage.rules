rules_version = '2';

// Avatars and banners are part of the profile shell (shown even on private
// profiles), so they're public to read and owner-only to write. Every upload gets
// a fresh name (see packages/firebase/src/repos/images.ts), so there are no overwrites.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/{file} {
      allow read: if true;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email_verified == true
        && file.matches('(avatar|banner)-[0-9A-Za-z]+[.]jpg')
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
