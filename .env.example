# Copy the relevant lines into apps/web/.env.local or apps/mobile/.env.local (both gitignored).

# apps/web — contact info (email or URL) appended to the Open Library User-Agent.
# Open Library asks clients to identify themselves; set this before deploying.
OPEN_LIBRARY_CONTACT=

# apps/mobile — base URL of the web app, whose /api/books proxy the app uses for search.
# On a physical device use your machine's LAN IP, e.g. http://192.168.1.20:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Firebase (prototype `data=firebase` mode). Leave the project ID unset to use the
# local emulators with the demo project: run `pnpm emulators` (needs Java 21+).
# To use a real project, copy its web-app config from the Firebase console:
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_APP_ID=
# apps/mobile: the same values with the EXPO_PUBLIC_ prefix, plus (emulators on a phone):
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=
